{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/ledger.schema.json",
  "title": "Cost ledger record v1",
  "description": "Một dòng JSONL cho mỗi lời gọi model (R5). Key idempotent (task_id, call_id, attempt): retry, replay hay fallback không bị đếm trùng. Token là delta. Giá lấy từ config/prices.yaml.",
  "type": "object",
  "required": ["v", "ts", "task_id", "attempt", "call_id", "agent", "requested_model", "served_model", "vendor", "model_id_source", "fallback_reason", "effort", "input_tokens", "output_tokens", "estimated", "cost_usd", "prices_version"],
  "properties": {
    "v": {"type": "integer", "minimum": 1},
    "ts": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "agent": {"type": "string", "minLength": 1},
    "requested_model": {"type": ["string", "null"]},
    "served_model": {"type": ["string", "null"], "description": "Model thực sự phục vụ, sau fallback."},
    "vendor": {"type": ["string", "null"]},
    "model_id_source": {"enum": ["cli_metadata", "router_log", "unknown"]},
    "fallback_reason": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "estimated": {"type": "boolean", "description": "true khi tuyến không báo token (ví dụ agy)."},
    "cost_usd": {"type": ["number", "null"], "minimum": 0, "description": "null khi model không có trong prices.yaml."},
    "prices_version": {"type": ["string", "null"]}
  }
}
