{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/incident.schema.json",
  "title": "Incident record v1",
  "description": "Bản ghi incident (PR-4a, R10), mở TAY theo docs/runbooks/incident.md. Nằm trong state_dir (ngoài repo, R13): `<state_dir>/incidents/<incident_id>.json`, kèm một GitHub issue nhãn `incident`. GitHub issue là nơi thảo luận; file này là bản ghi máy đọc được cho dashboard. BEST-EFFORT, KHÔNG CHỐNG GIẢ MẠO (R15). Trường lạ được bỏ qua để tương thích N-1/N+1.",
  "type": "object",
  "required": ["v", "incident_id", "opened_at", "opened_by", "status", "severity", "trigger", "summary", "release", "killswitch_engaged", "revert", "timeline"],
  "properties": {
    "v": {"type": "integer", "minimum": 1},
    "incident_id": {"type": "string", "pattern": "^INC-[0-9]{8}-[0-9]{2}$", "description": "INC-YYYYMMDD-NN theo ngày KST."},
    "opened_at": {"type": "string", "minLength": 1, "description": "KST (Asia/Seoul)."},
    "opened_by": {"const": "user", "description": "MVP: chỉ người dùng mở incident."},
    "status": {"enum": ["open", "frozen", "mitigated", "resolved"], "description": "frozen: revert conflict hoặc chưa rõ nguyên nhân, kill-switch bật, chờ người dùng."},
    "severity": {"enum": ["sev1", "sev2", "sev3"]},
    "trigger": {"enum": ["readonly_check_failed", "bug_report", "revert_conflict", "killswitch_unreadable", "other"]},
    "summary": {"type": "string", "minLength": 1},
    "github_issue": {"type": ["integer", "null"], "minimum": 1},
    "release": {
      "type": "object",
      "required": ["prev_tag", "new_tag", "manifest_id"],
      "properties": {
        "prev_tag": {"type": ["string", "null"]},
        "new_tag": {"type": ["string", "null"]},
        "manifest_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "readonly_check": {"type": ["object", "null"], "description": "Báo cáo JSON của `python -m release.readonly_check run` nếu có."},
    "killswitch_engaged": {"type": "boolean"},
    "revert": {
      "type": "object",
      "required": ["status", "branch", "pr", "reverted", "conflict"],
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "conflict", "pr_opened", "merged", "not_needed"]},
        "branch": {"type": ["string", "null"]},
        "pr": {"type": ["integer", "null"], "minimum": 1},
        "reverted": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "description": "SHA đã revert, theo thứ tự ngược manifest."},
        "conflict": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["sha", "files"],
              "properties": {
                "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "files": {"type": "array", "items": {"type": "string"}}
              }
            }
          ]
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ts", "actor", "note"],
        "properties": {
          "ts": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
